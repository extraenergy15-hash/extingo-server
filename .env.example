# Extingo Server — environment variables
#
# Copy this file to `.env`, fill in your real values, then load it into
# your shell before starting the server, e.g.:
#
#   export $(grep -v '^#' .env | xargs)
#   python3 server.py
#
# Never commit your real `.env` file — only this `.env.example` template
# should be checked into version control.

# Telegram bot token from @BotFather (Upgrade 3).
# Format: "<numeric_id>:<alphanumeric_token>"
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Telegram chat ID that alerts/photos should be sent to (Upgrade 3).
# Get this from @userinfobot or the Telegram Bot API getUpdates response.
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# Public ngrok URL for this server, used to register the Telegram webhook
# at startup (Upgrade 3). Must include the scheme, no trailing slash, e.g.
# https://your-subdomain.ngrok-free.dev
# Run `ngrok http 5000` separately to get this value — see README.md.
NGROK_URL=https://YOUR_SUBDOMAIN.ngrok-free.dev

# Telegram username (without the leading @) registered with CallMeBot for
# voice-call alerts (Upgrade 4).
CALLMEBOT_TELEGRAM_USERNAME=YOUR_TELEGRAM_USERNAME
